{
  "name": "taskflow",
  "version": "1.2.0",
  "description": "Plateforme de gestion de projets collaboratifs",
  "main": "index.js",
  "private": true,
  "scripts": {
    "start": "node -e \"if(require('fs').existsSync('server')){process.chdir('server');} require('./index.js');\"",
    "build": "node -e \"const cp=require('child_process'), fs=require('fs'); if(fs.existsSync('server')){cp.execSync('cd server && npm install', {stdio:'inherit'});} cp.execSync('npm install', {stdio:'inherit'});\"",
    "install:server": "cd server && npm install",
    "install:client": "cd client && npm install",
    "install:all": "npm run install:server && npm run install:client",
    "seed": "node -e \"if(require('fs').existsSync('server')){process.chdir('server');} require('./config/seed.js');\"",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "start:server": "cd server && node index.js"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.35.2",
    "socket.io": "^4.6.1",
    "sqlite3": "^5.1.6"
  }
}
